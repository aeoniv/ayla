# Copy to .env for local runs. NEVER commit a real .env.
# For a local dry run you can instead set DRY_RUN=1 and skip the GCP values.

# Telegram bot token (secret) — HMAC key source for initData validation.
TELEGRAM_BOT_TOKEN=

# GCP project that hosts Firestore + the video bucket.
GCP_PROJECT_ID=

# The single GCS bucket the service may mint signed URLs for.
VIDEO_BUCKET=

# Service account email used for V4 signing via IAM SignBlob (no key file).
# Leave blank to use the Cloud Run runtime service account.
SIGNER_SERVICE_ACCOUNT=

# Signed-URL lifetime in seconds (spec: 600 = 10 minutes).
SIGNED_URL_TTL_SECONDS=600

# Set to 1 for a credential-free local dry run.
DRY_RUN=0
