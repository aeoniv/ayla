{
  "name": "delivery-service",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless Cloud Run service for Telegram VoD entitlement + signed-URL delivery",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx test/**/*.test.ts",
    "dryrun": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/storage": "^7.14.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
