# Ayla — environment (copy to .env, never commit .env)

# --- Telegram ---
TELEGRAM_BOT_USERNAME=Ayla_Bot
TELEGRAM_BOT_TOKEN=            # from BotFather
OWNER_TELEGRAM_ID=            # hardcoded owner id (Phase 3/7)

# Payments: Telegram Stars (XTR) ONLY. Stars invoices use an EMPTY provider token.
# Do NOT set a third-party (e.g. Smart Glocal) provider token for digital goods.
TELEGRAM_PROVIDER_TOKEN=      # leave EMPTY for XTR / Stars
TELEGRAM_WEBHOOK_SECRET=      # random string; pass to setWebhook secret_token
SESSION_SECRET=              # strong random value in prod (>=32 bytes)

# --- GCP (Phase 1 + 2) ---
GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)  # non-default only if GCP_PROJECT_ID is shared with another app
GCS_BUCKET=

# --- pose-scoring-service (Phase 2) + authoring (Phase 3) ---
# Shared secret for delivery-service -> /score/authoring internal calls.
INTERNAL_API_KEY=
# delivery-service -> pose-scoring-service base URL (Phase 3 authoring).
POSE_SCORING_URL=

# --- Coaching model (Phase 5) ---
# Owner chose Gemini 3.1 Flash-Lite instead of the Anthropic API.
COACHING_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
