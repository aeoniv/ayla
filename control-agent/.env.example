# Ayla control-agent — env (copy to .env / /etc/ayla/monitor.env; never commit)

# --- monitor ---
# JSON array of services to poll. Leave coaching-agent-service out (or url:"")
# until Phase 5 is deployed.
SERVICES=[{"name":"delivery-service","url":"https://delivery-XXXX.run.app"},{"name":"pose-scoring-service","url":"https://pose-XXXX.run.app"}]
POLL_INTERVAL=300
FAIL_THRESHOLD=2
HTTP_TIMEOUT=10

# Separate OPS bot (not the student-facing Ayla_Bot). Owner must /start it once
# so it can DM them. OWNER_CHAT_ID is the owner's numeric Telegram id.
CONTROL_BOT_TOKEN=
OWNER_CHAT_ID=

# --- gateway (openclaw.yaml) ---
# This host's tailscale0 IP. NEVER 0.0.0.0.
TAILSCALE_IP=

# --- deploy agent only (separate host/user) ---
GCP_PROJECT_ID=
GCLOUD_REGION=asia-east1
